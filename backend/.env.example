APP_NAME=AI Missing Person Finder API
APP_VERSION=0.1.0
ENVIRONMENT=development

# Use a dedicated MySQL user, not root.
# URL-encode reserved characters in the password if necessary.
DATABASE_URL=mysql+pymysql://mpf_app:CHANGE_ME@127.0.0.1:3306/missing_person_finder?charset=utf8mb4

# Comma-separated origins allowed to call the API from a browser.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
